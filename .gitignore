# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
firebase-debug.log*

# Microsoft Office temporary files
~$*.docx
~$*.xlsx
~$*.xls

# env files (can opt-in for committing if needed)
.env*
!.env.security.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# local security test runtime / emulator data
/.security-tools/
/.security-emulator-data/
/.security-diagnosis-accounts.json
/.security-staging-service-account.json
/firebase-security-debug.log
/firestore-debug.log

# local visual QA output
/.visual-qa/

# local work files (presentations, generated documents, one-off scripts)
/.codex-presentations/
/.codex-tmp/
/.codex_tmp/
/artifacts/
/outputs/
