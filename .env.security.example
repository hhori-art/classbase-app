# Security test environment only. Never replace these values with production credentials.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-classbase-security
NEXT_PUBLIC_FIREBASE_API_KEY=demo-security-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-classbase-security.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-classbase-security.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:security-test
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_PORT=9099
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIRESTORE_EMULATOR_PORT=8085
NEXT_PUBLIC_FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIREBASE_STORAGE_EMULATOR_PORT=9199

GCLOUD_PROJECT=demo-classbase-security
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# External Web diagnosis mode. Only the Web-diagnosis IPs specified in the
# supplied hearing sheet are allowed. Localhost remains available for setup.
SECURITY_DIAGNOSIS_MODE=true
ALLOWED_IPS=113.37.16.194,124.33.127.18
