rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function role() {
      return signedIn() ? myUser().role : null;
    }

    function isStudent() {
      return role() == 'student';
    }

    function isParent() {
      return role() == 'parent' || role() == 'guardian';
    }

    function isTeacher() {
      return role() == 'teacher';
    }

    function isAttendanceAdmin() {
      return role() == 'attendance_admin' ||
        role() == 'attendance_only' ||
        role() == 'attendance_manager';
    }

    function canUseTeacherAttendance() {
      return isTeacher() || isAttendanceAdmin();
    }

    function isAdminRole() {
      return role() == 'admin' ||
        role() == 'master' ||
        role() == 'school_admin' ||
        role() == 'branch_admin' ||
        role() == 'campus_admin' ||
        role() == 'classroom_admin' ||
        role() == 'test_admin' ||
        role() == 'master_admin' ||
        role() == 'super_admin';
    }

    function isAdmin() {
      return role() == 'master' ||
        (isAdminRole() && (
          !myUser().keys().hasAny(['admin_permissions']) ||
          myUser().admin_permissions.science_social == true
        ));
    }

    function isMaster() {
      return role() == 'master';
    }

    function adminSafeUserUpdate() {
      return isAdmin() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'admin', 'admin_permissions', 'eiken_admin', 'enabled_programs',
          'permissions_updated_at', 'permissions_updated_by',
          'email', 'lifetime_id', 'initial_login_id',
          'initial_password', 'raw_password', 'password', 'parent_initial_password',
          'initial_password_policy', 'isFirstLogin',
          'account_status', 'status', 'suspended_at', 'withdrawn_at', 'archived_at',
          'school_ids'
        ]);
    }

    function isEikenAdmin() {
      return role() == 'master' ||
        (isAdminRole() && (
          (myUser().keys().hasAny(['admin_permissions']) && myUser().admin_permissions.eiken == true) ||
          (!myUser().keys().hasAny(['admin_permissions']) &&
            myUser().keys().hasAny(['eiken_admin']) &&
            myUser().eiken_admin == true)
        ));
    }

    function isEikenCollection(collection) {
      return collection in [
        'course_enrollments',
        'eiken_courses',
        'eiken_course_units',
        'eiken_tasks',
        'eiken_task_progress',
        'eiken_lessons',
        'eiken_attendance',
        'eiken_assignments',
        'eiken_submissions',
        'eiken_quizzes',
        'eiken_quiz_questions',
        'eiken_quiz_results',
        'eiken_writing_submissions',
        'eiken_teacher_assignments',
        'eiken_announcements',
        'eiken_follow_up_records'
      ];
    }

    function isAttendanceManager() {
      return role() == 'master' ||
        isAttendanceAdmin() ||
        (isAdminRole() && (
          !myUser().keys().hasAny(['admin_permissions']) ||
          myUser().admin_permissions.attendance == true
        ));
    }

    function canManageSchool(school) {
      return role() == 'master' ||
        (isAdmin() && (school == null || (myUser().school_ids is list && school in myUser().school_ids) || school == myUser().school || school == myUser().school_id || school == myUser().classroom));
    }

    function parentLinkedTo(studentId) {
      return isParent() &&
        ((myUser().student_ids is list && studentId in myUser().student_ids) ||
          get(/databases/$(database)/documents/users/$(studentId)).data.parent_uid == request.auth.uid);
    }

    function userSafeUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'coins', 'total_coins', 'points', 'total_points', 'risk', 'churn_risk',
        'role', 'admin', 'school_ids', 'account_status', 'status',
        'earned_badges', 'attendance_count', 'quest_clear_count',
        'initial_password', 'raw_password', 'password', 'parent_initial_password',
        'initial_password_policy', 'isFirstLogin',
        'enabled_programs', 'eiken_teacher', 'eiken_admin', 'admin_permissions',
        'permissions_updated_at', 'permissions_updated_by',
        'parent_uid', 'parent_ids', 'student_ids',
        'recovery_email', 'recovery_email_verified_at', 'pending_recovery_email',
        'recovery_email_verification_sent_at'
      ]);
    }

    function studentOwnedCreate() {
      return isStudent() && (
        request.resource.data.user_id == request.auth.uid ||
        request.resource.data.student_id == request.auth.uid ||
        request.resource.data.uid == request.auth.uid ||
        request.resource.data.creator_uid == request.auth.uid
      );
    }

    function parentOwnedCreate() {
      return isParent() &&
        request.resource.data.parent_id == request.auth.uid &&
        parentLinkedTo(request.resource.data.student_id);
    }

    function courseRegistrationOwnerCreate() {
      return signedIn() &&
        (
          (isStudent() && request.resource.data.student_id == request.auth.uid) ||
          (isParent() && request.resource.data.parent_id == request.auth.uid && parentLinkedTo(request.resource.data.student_id))
        ) &&
        request.resource.data.status in ['active', 'submitted'] &&
        !request.resource.data.keys().hasAny(['approved_by', 'approved_at']);
    }

    function courseRegistrationOwnerUpdate() {
      return signedIn() &&
        (
          (isStudent() && resource.data.student_id == request.auth.uid && request.resource.data.student_id == request.auth.uid) ||
          (isParent() && resource.data.parent_id == request.auth.uid && request.resource.data.parent_id == request.auth.uid && parentLinkedTo(resource.data.student_id))
        ) &&
        request.resource.data.status in ['active', 'submitted'] &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'student_id', 'parent_id', 'approved_by', 'approved_at'
        ]);
    }

    function topicSafeReactionUpdate() {
      return signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'likes', 'liked_by', 'votes', 'voted_by', 'updated_at'
        ]);
    }

    function topicOwnerSafeUpdate() {
      return signedIn() &&
        resource.data.creator_uid == request.auth.uid &&
        request.resource.data.creator_uid == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'creator_uid', 'created_at', 'is_approved'
        ]);
    }

    function teacherOwnAvailabilityCreate() {
      return isTeacher() &&
        (
          request.resource.data.teacher_id == request.auth.uid ||
          request.resource.data.user_id == request.auth.uid
        );
    }

    function teacherOwnAvailabilityUpdate() {
      return isTeacher() &&
        (
          resource.data.teacher_id == request.auth.uid ||
          resource.data.user_id == request.auth.uid
        ) &&
        (
          request.resource.data.teacher_id == request.auth.uid ||
          request.resource.data.user_id == request.auth.uid
        ) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'teacher_id', 'created_at', 'created_by'
        ]);
    }

    function teacherWorkCreate() {
      return false;
    }

    function teacherWorkUpdate() {
      return canUseTeacherAttendance() &&
        resource.data.teacher_id == request.auth.uid &&
        request.resource.data.teacher_id == request.auth.uid &&
        (!resource.data.keys().hasAny(['status']) || resource.data.status != 'approved') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'attendance_kind',
          'work_segments',
          'transportation',
          'updated_at',
          'updated_at_server'
        ]);
    }

    match /users/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        isEikenAdmin() ||
        isAttendanceManager() ||
        parentLinkedTo(userId)
      );
      allow create: if isMaster();
      allow update: if signedIn() && (
        isMaster() ||
        adminSafeUserUpdate() ||
        (request.auth.uid == userId && userSafeUpdate())
      );
      allow delete: if isMaster();

      match /chat_history/{messageId} {
        allow read: if signedIn() && (request.auth.uid == userId || isTeacher() || isAdmin() || parentLinkedTo(userId));
        allow create: if signedIn() && request.auth.uid == userId;
        allow update, delete: if isAdmin();
      }

      match /point_history/{historyId} {
        allow read: if signedIn() && (request.auth.uid == userId || isTeacher() || isAdmin() || parentLinkedTo(userId));
        allow write: if false;
      }
    }

    match /learning_events/{eventId} {
      allow read: if isTeacher() || isAdmin();
      allow write: if false;
    }

    match /recording_views/{viewId} {
      allow read: if signedIn() && (
        resource.data.user_id == request.auth.uid ||
        isTeacher() ||
        isAdmin() ||
        parentLinkedTo(resource.data.user_id)
      );
      allow write: if false;
    }

    match /coin_transactions/{transactionId} {
      allow read: if signedIn() && (resource.data.user_id == request.auth.uid || isTeacher() || isAdmin() || parentLinkedTo(resource.data.user_id));
      allow write: if false;
    }

    match /camera_session_summaries/{summaryId} {
      allow read: if signedIn() && (resource.data.student_id == request.auth.uid || isTeacher() || isAdmin() || parentLinkedTo(resource.data.student_id));
      allow write: if false;
    }

    match /notification_jobs/{jobId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /notification_campaigns/{campaignId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /user_notifications/{notificationId} {
      allow read: if signedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // 再設定用トークン、送信キュー、試行回数はサーバー(Admin SDK)だけが扱う。
    match /password_reset_tokens/{tokenId} {
      allow read, write: if false;
    }

    match /email_verification_tokens/{tokenId} {
      allow read, write: if false;
    }

    match /password_recovery_rate_limits/{limitId} {
      allow read, write: if false;
    }

    match /password_recovery_requests/{requestId} {
      allow read, write: if false;
    }

    match /mail/{mailId} {
      allow read, write: if false;
    }

    match /monthly_schedules/{scheduleId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /annual_lesson_schedules/{scheduleId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /annual_curriculum_schedules/{scheduleId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /course_registration_options/{optionId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /course_registrations/{registrationId} {
      allow read: if signedIn() && (resource.data.parent_id == request.auth.uid || isAdmin() || parentLinkedTo(resource.data.student_id));
      allow create: if isAdmin() || courseRegistrationOwnerCreate();
      allow update: if isAdmin() || courseRegistrationOwnerUpdate();
      allow delete: if isAdmin();
    }

    match /attendance_correction_requests/{requestId} {
      allow read: if signedIn() && (resource.data.teacher_id == request.auth.uid || isAttendanceManager());
      allow write: if false;
    }

    match /attendance/{attendanceId} {
      allow read: if signedIn() && (resource.data.user_id == request.auth.uid || isTeacher() || isAdmin() || parentLinkedTo(resource.data.user_id));
      allow create: if isAdmin() || (isStudent() && request.resource.data.user_id == request.auth.uid);
      allow update: if isAdmin() ||
        (isStudent() &&
          resource.data.user_id == request.auth.uid &&
          request.resource.data.user_id == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'user_id', 'approved_at', 'approved_by', 'status', 'points', 'coins'
          ])
        );
      allow delete: if isAdmin();
    }

    match /submissions/{submissionId} {
      allow read: if signedIn() && (resource.data.student_id == request.auth.uid || isTeacher() || isAdmin() || parentLinkedTo(resource.data.student_id));
      allow create: if isStudent() && request.resource.data.student_id == request.auth.uid;
      allow update: if isAdmin() ||
        (isTeacher() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['student_id', 'assignment_id'])) ||
        (isStudent() && request.resource.data.student_id == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /homework_assignments/{assignmentId} {
      allow read: if signedIn();
      allow create, update, delete: if isTeacher() || isAdmin();
    }

    match /assignments/{assignmentId} {
      allow read: if signedIn();
      allow create, update, delete: if isTeacher() || isAdmin();
    }

    match /class_recordings/{recordingId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /teacher_inquiries/{inquiryId} {
      allow read: if isTeacher() || isAdmin();
      allow create: if isStudent() && request.resource.data.studentId == request.auth.uid;
      allow update: if isTeacher() || isAdmin();
      allow delete: if isAdmin();
    }

    match /chat_logs/{messageId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isTeacher() || isAdmin() || parentLinkedTo(resource.data.uid));
      allow create: if isTeacher() || isAdmin() || (isStudent() && request.resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /community_topics/{topicId} {
      allow read: if signedIn();
      allow create: if isStudent() && request.resource.data.creator_uid == request.auth.uid;
      allow update: if isAdmin() || topicOwnerSafeUpdate() || topicSafeReactionUpdate();
      allow delete: if isAdmin() || (signedIn() && resource.data.creator_uid == request.auth.uid);

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if isStudent() && request.resource.data.uid == request.auth.uid;
        allow update, delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      }
    }

    match /teacher_community_topics/{topicId} {
      allow read: if isTeacher() || isAdmin();
      allow create: if isTeacher() && request.resource.data.creator_uid == request.auth.uid;
      allow update: if isAdmin() || topicOwnerSafeUpdate() || topicSafeReactionUpdate();
      allow delete: if isAdmin() || (isTeacher() && resource.data.creator_uid == request.auth.uid);

      match /comments/{commentId} {
        allow read: if isTeacher() || isAdmin();
        allow create: if isTeacher() && request.resource.data.uid == request.auth.uid;
        allow update, delete: if isAdmin() || (isTeacher() && resource.data.uid == request.auth.uid);
      }
    }

    match /contact_logs/{logId} {
      allow read: if isTeacher() || isAdmin();
      allow create: if isTeacher() || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /pf_records/{recordId} {
      allow read: if signedIn() && (isTeacher() || isAdmin() || resource.data.student_id == request.auth.uid || parentLinkedTo(resource.data.student_id));
      allow create, update: if isTeacher() || isAdmin();
      allow delete: if isAdmin();
    }

    match /pf_resolutions/{resolutionId} {
      allow read: if isTeacher() || isAdmin();
      allow create, update: if isTeacher() || isAdmin();
      allow delete: if isAdmin();
    }

    match /work_records/{recordId} {
      allow read: if signedIn() && (resource.data.teacher_id == request.auth.uid || isAttendanceManager());
      allow create: if teacherWorkCreate();
      allow update: if teacherWorkUpdate() || isAttendanceManager();
      allow delete: if isAttendanceManager();
    }

    // 給与単価・通常勤怠インポートは機微情報のため、Admin SDK経由の専用APIのみ許可する。
    match /attendance_payroll_rate_masters/{rateId} {
      allow read, write: if false;
    }

    match /attendance_regular_imports/{importId} {
      allow read, write: if false;
    }

    match /attendance_import_batches/{batchId} {
      allow read, write: if false;
    }

    match /teacher_availability/{availabilityId} {
      allow read: if isTeacher() || isAttendanceManager();
      allow create: if teacherOwnAvailabilityCreate() || isAttendanceManager();
      allow update: if teacherOwnAvailabilityUpdate() || isAttendanceManager();
      allow delete: if isAttendanceManager() || (isTeacher() && (resource.data.teacher_id == request.auth.uid || resource.data.user_id == request.auth.uid));
    }

    match /teacher_commuter_passes/{passId} {
      allow read: if signedIn() && (resource.data.teacher_id == request.auth.uid || isAttendanceManager());
      allow create: if isAttendanceManager() || (canUseTeacherAttendance() && request.resource.data.teacher_id == request.auth.uid);
      allow update: if isAttendanceManager() || (
        canUseTeacherAttendance() &&
        resource.data.teacher_id == request.auth.uid &&
        request.resource.data.teacher_id == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['teacher_id', 'created_at', 'created_by'])
      );
      allow delete: if isAttendanceManager();
    }

    match /teacher_substitution_posts/{postId} {
      allow read: if isTeacher() || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /requests/{requestId} {
      allow read: if signedIn() && (
        resource.data.user_id == request.auth.uid ||
        resource.data.student_id == request.auth.uid ||
        resource.data.parent_id == request.auth.uid ||
        isTeacher() ||
        isAdmin() ||
        parentLinkedTo(resource.data.user_id) ||
        parentLinkedTo(resource.data.student_id)
      );
      allow create: if isAdmin() || isTeacher() || studentOwnedCreate() || parentOwnedCreate();
      allow update, delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /registration_requests/{requestId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /student_registrations/{registrationId} {
      allow read: if signedIn() && (
        resource.data.student_id == request.auth.uid ||
        isAdmin() ||
        parentLinkedTo(resource.data.student_id)
      );
      allow create: if isStudent() && request.resource.data.student_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /shift_assignments/{shiftId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if signedIn();
      allow write: if isMaster();
    }

    match /system_status/{statusId} {
      allow read: if true;
      allow write: if role() == 'master';
    }

    match /action_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /rewards/{rewardId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /learning_units/{unitId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /lesson_slides/{slideId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /quizzes/{quizId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /quest_results/{resultId} {
      allow read: if signedIn() && (
        resource.data.student_id == request.auth.uid ||
        isTeacher() ||
        isAdmin() ||
        parentLinkedTo(resource.data.student_id)
      );
      allow write: if isAdmin();
    }

    match /quest_question_attempts/{attemptId} {
      allow read: if signedIn() && (
        resource.data.student_id == request.auth.uid ||
        isTeacher() ||
        isAdmin() ||
        parentLinkedTo(resource.data.student_id)
      );
      allow create: if isStudent() && request.resource.data.student_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /quest_question_mastery/{masteryId} {
      allow read: if signedIn() && (
        resource.data.student_id == request.auth.uid ||
        isTeacher() ||
        isAdmin() ||
        parentLinkedTo(resource.data.student_id)
      );
      allow write: if isAdmin();
    }

    match /quest_unit_mastery/{masteryId} {
      allow read: if signedIn() && (
        resource.data.student_id == request.auth.uid ||
        isTeacher() ||
        isAdmin() ||
        parentLinkedTo(resource.data.student_id)
      );
      allow write: if isAdmin();
    }

    match /subject_urls/{urlId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /survey_templates/{templateId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /survey_responses/{responseId} {
      allow read: if signedIn() && (
        resource.data.user_id == request.auth.uid ||
        resource.data.student_id == request.auth.uid ||
        isTeacher() ||
        isAdmin()
      );
      allow create: if signedIn() && (
        request.resource.data.user_id == request.auth.uid ||
        request.resource.data.student_id == request.auth.uid ||
        isTeacher() ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['text', 'uid', 'name', 'role', 'created_at']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.role == role() &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 1000;
      allow update, delete: if isAdmin();
    }

    match /activity_logs/{logId} {
      allow read: if isAdmin();
      allow create: if signedIn() &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /parent_inquiries/{inquiryId} {
      allow read: if signedIn() && (resource.data.parent_id == request.auth.uid || isAdmin());
      allow create: if isParent() && request.resource.data.parent_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /course_enrollments/{enrollmentId} {
      allow read: if signedIn() && (
        resource.data.user_id == request.auth.uid ||
        parentLinkedTo(resource.data.user_id) ||
        isMaster()
      );
      allow create, update, delete: if isMaster();
    }

    match /eiken_courses/{courseId} {
      allow read: if signedIn();
      allow create, update, delete: if isMaster();
    }

    match /eiken_course_units/{unitId} {
      allow read, write: if isMaster();
    }

    match /eiken_tasks/{taskId} {
      allow read, write: if isMaster();
    }

    match /eiken_task_progress/{progressId} {
      allow read, write: if isMaster();
    }

    match /eiken_lessons/{lessonId} {
      allow read, write: if isMaster();
    }

    match /eiken_attendance/{attendanceId} {
      allow read, write: if isMaster();
    }

    match /eiken_assignments/{assignmentId} {
      allow read, write: if isMaster();
    }

    match /eiken_submissions/{submissionId} {
      allow read, write: if isMaster();
    }

    match /eiken_quizzes/{quizId} {
      allow read, write: if isMaster();
    }

    match /eiken_quiz_questions/{questionId} {
      allow read, write: if isMaster();
    }

    match /eiken_quiz_results/{resultId} {
      allow read, write: if isMaster();
    }

    match /eiken_writing_submissions/{submissionId} {
      allow read, write: if isMaster();
    }

    match /eiken_teacher_assignments/{assignmentId} {
      allow read, write: if isMaster();
    }

    match /eiken_announcements/{announcementId} {
      allow read, write: if isMaster();
    }

    match /eiken_follow_up_records/{recordId} {
      allow read, write: if isMaster();
    }

    match /{collection}/{document=**} {
      allow read: if isAdmin() && !isEikenCollection(collection);
      // 未定義コレクションへの包括的な書き込みはマスターだけに限定する。
      // 校舎管理者の操作は、上で用途ごとに定義したルールを通す。
      allow write: if isMaster() && !isEikenCollection(collection);
    }
  }
}
