rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null &&
        !(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('account_status', 'active') in ['suspended', 'withdrawn', 'archived']) &&
        !(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') in ['suspended', 'withdrawn', 'archived']);
    }

    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function role() {
      return signedIn() ? myUser().role : null;
    }

    function isStudent() {
      return role() == 'student';
    }

    function isParent() {
      return role() in ['parent', 'guardian'];
    }

    function isTeacher() {
      return role() == 'teacher';
    }

    function isAttendanceAdmin() {
      return role() in ['attendance_admin', 'attendance_only', 'attendance_manager'];
    }

    function isDedicatedAttendanceApprover() {
      return isTeacher() &&
        myUser().get('attendance_school_manager', false) == true &&
        (
          myUser().get('employment_category', '') in ['dedicated', 'employee', 'full_time', 'regular_employee', '専任', '社員', '正社員'] ||
          myUser().get('employment_type', '') in ['dedicated', 'employee', 'full_time', 'regular_employee', '専任', '社員', '正社員'] ||
          myUser().get('worker_type', '') in ['dedicated', 'employee', 'full_time', 'regular_employee', '専任', '社員', '正社員']
        );
    }

    function canUseTeacherAttendance() {
      return isTeacher() || isAttendanceAdmin();
    }

    function isAdminRole() {
      return role() in ['admin', 'master', 'school_admin', 'branch_admin', 'campus_admin',
        'classroom_admin', 'test_admin', 'master_admin', 'super_admin'];
    }

    function isAdmin() {
      return role() == 'master' ||
        (isAdminRole() && (
          !myUser().keys().hasAny(['admin_permissions']) ||
          myUser().admin_permissions.science_social == true
        ));
    }

    function isMaster() {
      return role() == 'master';
    }

    function adminSafeUserUpdate() {
      return isAdmin() &&
        resource.data.role in ['student', 'teacher', 'parent', 'guardian'] &&
        canManageSchool(resource.data.get('school_id', resource.data.get('school', null))) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'uid', 'id', 'email', 'lifetime_id', 'initial_login_id', 'credential_primary_uid',
          'staff_id', 'staffId', 'employee_id', 'employeeId', 'teacher_code',
          'school_code', 'schoolCode', 'school_name', 'schoolName', 'school_number', 'affiliation', 'department',
          'tp_serial', 'tpSerial', 'tp_number', 'tpNumber', 'tp',
          'prescribed_work_start', 'prescribed_work_end', 'prescribed_break_minutes', 'prescribed_work_days',
          'school', 'school_id', 'classroom',
          'employment_category', 'employment_type', 'worker_type', 'attendance_school_manager',
          'zoom_email', 'zoomEmail', 'target_signin_address', 'signin_address', 'teacher_zoom_email',
          'teacher_name', 'student_name', 'name', 'display_name', 'displayName', 'full_name',
          'role', 'admin', 'admin_permissions', 'eiken_admin', 'eiken_teacher', 'enabled_programs',
          'parent_uid', 'parent_ids', 'student_ids',
          'recovery_email', 'recovery_email_verified_at', 'pending_recovery_email', 'recovery_email_verification_sent_at',
          'permissions_updated_at', 'permissions_updated_by',
          'email', 'lifetime_id', 'initial_login_id',
          'initial_password', 'raw_password', 'password', 'parent_initial_password',
          'initial_password_policy', 'isFirstLogin',
          'account_status', 'status', 'suspended_at', 'withdrawn_at', 'archived_at',
          'school_ids', 'feature_overrides', 'owned_cosmetics'
        ]);
    }

    function isEikenAdmin() {
      return role() == 'master' ||
        (isAdminRole() && (
          (myUser().keys().hasAny(['admin_permissions']) && myUser().admin_permissions.eiken == true) ||
          (!myUser().keys().hasAny(['admin_permissions']) &&
            myUser().keys().hasAny(['eiken_admin']) &&
            myUser().eiken_admin == true)
        ));
    }

    function isEikenCollection(collection) {
      return collection in [
        'course_enrollments',
        'eiken_courses',
        'eiken_course_units',
        'eiken_tasks',
        'eiken_task_progress',
        'eiken_lessons',
        'eiken_attendance',
        'eiken_assignments',
        'eiken_submissions',
        'eiken_quizzes',
        'eiken_quiz_questions',
        'eiken_quiz_results',
        'eiken_writing_submissions',
        'eiken_teacher_assignments',
        'eiken_announcements',
        'eiken_follow_up_records'
      ];
    }

    function isAttendanceManager() {
      return role() == 'master' ||
        isAttendanceAdmin() ||
        // 勤怠は理社講座とは別の権限。権限を明示的に付けた管理者だけ（未設定の古いアカウントには付けない）。
        (isAdminRole() &&
          myUser().keys().hasAny(['admin_permissions']) &&
          myUser().admin_permissions.get('attendance', false) == true);
    }

    function canManageSchool(school) {
      return role() == 'master' ||
        (isAdmin() && (school == null || (myUser().school_ids is list && school in myUser().school_ids) || school == myUser().school || school == myUser().school_id || school == myUser().classroom));
    }

    function parentLinkedTo(studentId) {
      return isParent() &&
        ((myUser().student_ids is list && studentId in myUser().student_ids) ||
          get(/databases/$(database)/documents/users/$(studentId)).data.parent_uid == request.auth.uid);
    }

    function userSafeUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'uid', 'id', 'email', 'lifetime_id', 'initial_login_id', 'credential_primary_uid',
          'staff_id', 'staffId', 'employee_id', 'employeeId', 'teacher_code',
          'school_code', 'schoolCode', 'school_name', 'schoolName', 'school_number', 'affiliation', 'department',
          'tp_serial', 'tpSerial', 'tp_number', 'tpNumber', 'tp',
          'prescribed_work_start', 'prescribed_work_end', 'prescribed_break_minutes', 'prescribed_work_days',
          'school', 'school_id', 'classroom',
          'employment_category', 'employment_type', 'worker_type', 'attendance_school_manager',
          'zoom_email', 'zoomEmail', 'target_signin_address', 'signin_address', 'teacher_zoom_email',
          'teacher_name', 'student_name', 'name', 'display_name', 'displayName', 'full_name',
        'coins', 'total_coins', 'points', 'total_points', 'risk', 'churn_risk',
        'role', 'admin', 'school_ids', 'account_status', 'status',
        'earned_badges', 'attendance_count', 'quest_clear_count',
        // 報酬判定・配信対象の絞り込みにサーバーが使う属性は本人が変更できない。
        'grade', 'class', 'subjects', 'test_subjects', 'login_streak', 'last_login_bonus_date',
        'feature_overrides', 'owned_cosmetics', 'best_login_streak', 'homework_count', 'recording_complete_count',
        'community_activity_count', 'reward_exchange_count', 'gacha_draw_count', 'gacha_win_count',
        'initial_password', 'raw_password', 'password', 'parent_initial_password',
        'initial_password_policy', 'isFirstLogin',
        'enabled_programs', 'eiken_teacher', 'eiken_admin', 'admin_permissions',
        'permissions_updated_at', 'permissions_updated_by',
        'parent_uid', 'parent_ids', 'student_ids',
        'recovery_email', 'recovery_email_verified_at', 'pending_recovery_email',
        'recovery_email_verification_sent_at'
      ]);
    }

    // 装備できるのは獲得済みのバッジだけ（獲得はサーバーが earned_badges に記録する）。
    function selectedBadgeIsEarned() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['selected_badge']) ||
        request.resource.data.selected_badge == 'badge_1' ||
        request.resource.data.selected_badge in resource.data.get('earned_badges', []);
    }

    function studentOwnedCreate() {
      return isStudent() && (
        request.resource.data.user_id == request.auth.uid ||
        request.resource.data.student_id == request.auth.uid ||
        request.resource.data.uid == request.auth.uid ||
        request.resource.data.creator_uid == request.auth.uid
      );
    }

    function parentOwnedCreate() {
      return isParent() &&
        request.resource.data.parent_id == request.auth.uid &&
        parentLinkedTo(request.resource.data.student_id);
    }

    function teacherWorkCreate() {
      return false;
    }

    function teacherWorkUpdate() {
      // 勤務内訳は校舎別承認情報を含むため、講師本人は Admin SDK の専用API経由で更新する。
      return false;
    }

    match /users/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId ||
        isMaster() ||
        (resource.data.role in ['student', 'teacher', 'parent', 'guardian', 'attendance_admin', 'attendance_only', 'attendance_manager'] &&
          (isAdmin() || isEikenAdmin() || isAttendanceManager())) ||
        parentLinkedTo(userId)
      );
      allow create: if isMaster();
      allow update: if signedIn() && (
        isMaster() ||
        adminSafeUserUpdate() ||
        (request.auth.uid == userId && userSafeUpdate() && selectedBadgeIsEarned())
      );
      allow delete: if isMaster();

      match /chat_history/{messageId} {
        allow read, write: if false;
      }

      match /point_history/{historyId} {
        allow read: if signedIn() && (request.auth.uid == userId || isTeacher() || isAdmin() || parentLinkedTo(userId));
        allow write: if false;
      }
    }

    match /learning_events/{eventId} {
      allow read: if isTeacher() || isAdmin();
      allow write: if false;
    }

    match /recording_views/{viewId} {
      allow read: if signedIn() && (
        resource.data.user_id == request.auth.uid ||
        isTeacher() ||
        isAdmin() ||
        parentLinkedTo(resource.data.user_id)
      );
      allow write: if false;
    }

    match /coin_transactions/{transactionId} {
      allow read: if signedIn() && (resource.data.user_id == request.auth.uid || isTeacher() || isAdmin() || parentLinkedTo(resource.data.user_id));
      allow write: if false;
    }

    match /camera_session_summaries/{summaryId} {
      allow read: if signedIn() && (resource.data.student_id == request.auth.uid || isTeacher() || isAdmin() || parentLinkedTo(resource.data.student_id));
      allow write: if false;
    }

    match /notification_jobs/{jobId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /notification_campaigns/{campaignId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /user_notifications/{notificationId} {
      allow read: if signedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // 再設定用トークン、送信キュー、試行回数はサーバー(Admin SDK)だけが扱う。
    match /password_reset_tokens/{tokenId} {
      allow read, write: if false;
    }

    match /email_verification_tokens/{tokenId} {
      allow read, write: if false;
    }

    match /password_recovery_rate_limits/{limitId} {
      allow read, write: if false;
    }

    match /password_recovery_requests/{requestId} {
      allow read, write: if false;
    }

    match /mail/{mailId} {
      allow read, write: if false;
    }

    match /monthly_schedules/{scheduleId} {
      // 生徒・保護者には校舎・学年・対象ロールを検証するAPI経由で配信する。
      allow read: if isTeacher() || isAdmin();
      allow write: if false;
    }

    match /annual_lesson_schedules/{scheduleId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /annual_curriculum_schedules/{scheduleId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /course_registration_options/{optionId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /test_prep_course_options/{optionId} {
      allow read, write: if false;
    }

    match /course_registrations/{registrationId} {
      allow read: if signedIn() && (resource.data.parent_id == request.auth.uid || isAdmin() || parentLinkedTo(resource.data.student_id));
      // 候補、学年、受付期間、重複を再検証する専用API（Admin SDK）だけが更新する。
      allow write: if false;
    }

    match /attendance_correction_requests/{requestId} {
      allow read: if signedIn() && (resource.data.teacher_id == request.auth.uid || isAttendanceManager());
      allow write: if false;
    }

    match /attendance/{attendanceId} {
      allow read: if signedIn() && (resource.data.user_id == request.auth.uid || isTeacher() || isAdmin() || parentLinkedTo(resource.data.user_id));
      // 出席の作成・更新は、授業の存在と当日性を検証する専用API（Admin SDK）に限定する。
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /submissions/{submissionId} {
      allow read: if signedIn() && (resource.data.student_id == request.auth.uid || isTeacher() || isAdmin() || parentLinkedTo(resource.data.student_id));
      // 提出と講師確認は課題対象・画像・状態遷移を検証する専用APIのみが書き込む。
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    match /homework_assignments/{assignmentId} {
      // 生徒には学年・受講科目を検証する専用API経由でのみ配信する。
      allow read: if isTeacher() || isAdmin();
      allow create, update, delete: if isTeacher() || isAdmin();
    }

    match /assignments/{assignmentId} {
      allow read: if signedIn();
      allow create, update, delete: if isTeacher() || isAdmin();
    }

    match /class_recordings/{recordingId} {
      // 生徒には学年・科目・校舎・公開状態を検証するAPI経由で配信する。
      allow read: if isTeacher() || isAdmin();
      allow write: if isAdmin();
    }

    // Zoom録画の再生パスコードはAdmin SDKからのみ利用する。
    match /recording_playback_secrets/{recordingId} {
      allow read, write: if false;
    }

    match /recording_playback_sessions/{sessionId} {
      allow read, write: if false;
    }

    match /teacher_inquiries/{inquiryId} {
      allow read, write: if false;
    }

    match /chat_logs/{messageId} {
      allow read, write: if false;
    }

    match /community_topics/{topicId} {
      allow read: if signedIn() && (isAdmin() || resource.data.is_approved == true);
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if signedIn() && (
          isAdmin() ||
          get(/databases/$(database)/documents/community_topics/$(topicId)).data.is_approved == true
        );
        allow create: if false;
        allow update, delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      }
    }

    // 交流掲示板の通報。生徒はサーバーAPI（/api/student/community）経由でだけ作成し、
    // 通報者が分からないよう、クライアントからは誰も直接読み書きできない（管理者もAdmin SDK経由）。
    match /community_reports/{reportId} {
      allow read, write: if false;
    }

    match /teacher_community_topics/{topicId} {
      allow read: if isTeacher() || isAdmin();
      // サーバーで入力上限、投票、いいね、所有者を検証する。
      allow create, update, delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if isTeacher() || isAdmin();
        allow create, update, delete: if isAdmin();
      }
    }

    match /contact_logs/{logId} {
      allow read: if isTeacher() || isAdmin();
      allow create: if isTeacher() || isAdmin();
      allow update, delete: if isMaster();
    }

    // 未連絡リストの電話済み記録。/api/teacher/contact-call-marks（Admin SDK）からのみ読み書きする。
    match /contact_call_logs/{logId} {
      allow read, write: if false;
    }

    // Zoomホスト開始の監査ログ（誰がどの授業を開始したか）。/api/get-zoom-zak からのみ書き込む。
    match /zoom_host_start_logs/{logId} {
      allow read, write: if false;
    }

    match /pf_records/{recordId} {
      allow read: if signedIn() && (isTeacher() || isAdmin() || resource.data.student_id == request.auth.uid || parentLinkedTo(resource.data.student_id));
      allow create, update: if isTeacher() || isAdmin();
      allow delete: if isAdmin();
    }

    match /pf_resolutions/{resolutionId} {
      allow read: if isTeacher() || isAdmin();
      allow create, update: if isTeacher() || isAdmin();
      allow delete: if isAdmin();
    }

    match /work_records/{recordId} {
      allow read: if signedIn() && (resource.data.teacher_id == request.auth.uid || isAttendanceManager());
      // 承認者の更新・削除は担当校舎を検証する専用APIだけに集約する。
      // masterの旧管理画面の後方互換書き込みのみ直接操作を許可する。
      allow create, update, delete: if isMaster();
    }

    // 給与単価・通常勤怠インポートは機微情報のため、Admin SDK経由の専用APIのみ許可する。
    match /attendance_payroll_rate_masters/{rateId} {
      allow read, write: if false;
    }

    match /attendance_regular_imports/{importId} {
      // 取込元の給与データは専用APIで校舎範囲を検証して返す。
      allow read, write: if false;
    }

    match /attendance_import_batches/{batchId} {
      allow read, write: if false;
    }

    match /attendance_integration_alerts/{alertId} {
      allow read: if isAttendanceManager();
      allow write: if false;
    }

    match /attendance_integration_batches/{batchId} {
      allow read, write: if false;
    }

    match /attendance_integration_history/{historyId} {
      allow read: if isAttendanceManager();
      allow write: if false;
    }

    match /teacher_availability/{availabilityId} {
      // 講師の提出・取り消しは /api/teacher/shifts で過去日・配置済みを検証してから書き込む。
      allow read: if isTeacher() || isAttendanceManager();
      allow create, update, delete: if isAttendanceManager();
    }

    match /teacher_availability_profiles/{teacherId} {
      // 講師本人の保存は /api/teacher/availability-profile で本人・校舎・時刻を検証してから書き込む。
      allow read: if isAttendanceManager() || (isTeacher() && teacherId == request.auth.uid);
      allow create, update, delete: if isAttendanceManager();
    }

    match /teacher_commuter_passes/{passId} {
      allow read: if signedIn() && (resource.data.teacher_id == request.auth.uid || isAttendanceManager());
      allow create: if isAttendanceManager() || (canUseTeacherAttendance() && request.resource.data.teacher_id == request.auth.uid);
      allow update: if isAttendanceManager() || (
        canUseTeacherAttendance() &&
        resource.data.teacher_id == request.auth.uid &&
        request.resource.data.teacher_id == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['teacher_id', 'created_at', 'created_by'])
      );
      allow delete: if isAttendanceManager();
    }

    match /teacher_substitution_posts/{postId} {
      // 講師の依頼・返答・取り下げは /api/teacher/substitutions で担当授業を検証して書き込む。
      allow read: if isTeacher() || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /requests/{requestId} {
      allow read: if signedIn() && (
        resource.data.user_id == request.auth.uid ||
        resource.data.student_id == request.auth.uid ||
        resource.data.parent_id == request.auth.uid ||
        isTeacher() ||
        isAdmin() ||
        parentLinkedTo(resource.data.user_id) ||
        parentLinkedTo(resource.data.student_id)
      );
      allow create: if isAdmin() || isTeacher() || studentOwnedCreate() || parentOwnedCreate();
      allow update, delete: if false;
    }

    match /announcements/{announcementId} {
      // 送信対象・校舎・学年の判定は /api/announcements で行う。
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /registration_requests/{requestId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /student_registrations/{registrationId} {
      allow read: if signedIn() && (
        resource.data.student_id == request.auth.uid ||
        isAdmin() ||
        parentLinkedTo(resource.data.student_id)
      );
      allow create: if isStudent() && request.resource.data.student_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /shift_assignments/{shiftId} {
      // 生徒の授業候補は受講登録を検証する専用APIから返す。
      allow read: if isTeacher() || isAdmin();
      allow write: if isMaster() || isDedicatedAttendanceApprover();
    }

    match /attendance_shift_plans/{shiftId} {
      // 校舎範囲・職員所属・CSV一括処理を専用APIで検証する。
      allow read, write: if false;
    }

    match /settings/{settingId} {
      allow read: if signedIn();
      allow write: if isMaster();
    }

    match /system_status/{statusId} {
      allow read: if true;
      allow write: if role() == 'master';
    }

    match /action_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /rewards/{rewardId} {
      allow read, write: if false;
    }

    // ガチャ設定・抽選結果・デジタル景品の受け取り記録は専用API（Admin SDK）だけが扱う。
    match /gachas/{gachaId} {
      allow read, write: if false;
    }

    match /gacha_draws/{drawId} {
      allow read, write: if false;
    }

    match /reward_grants/{grantId} {
      allow read, write: if false;
    }

    match /learning_units/{unitId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /lesson_slides/{slideId} {
      allow read: if isTeacher() || isAdmin();
      allow write: if false;
    }

    match /quizzes/{quizId} {
      // 正解を含むため生徒には直接読ませず、/api/quest-sessions が選択肢だけを返す。
      allow read: if isTeacher() || isAdmin();
      allow write: if false;
    }

    match /quest_results/{resultId} {
      allow read: if signedIn() && (
        resource.data.student_id == request.auth.uid ||
        isTeacher() ||
        isAdmin() ||
        parentLinkedTo(resource.data.student_id)
      );
      allow write: if isAdmin();
    }

    match /quest_sessions/{sessionId} {
      allow read, write: if false;
    }

    match /quest_question_attempts/{attemptId} {
      allow read: if signedIn() && (
        resource.data.student_id == request.auth.uid ||
        isTeacher() ||
        isAdmin() ||
        parentLinkedTo(resource.data.student_id)
      );
      allow create: if isStudent() && request.resource.data.student_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /quest_question_mastery/{masteryId} {
      allow read: if signedIn() && (
        resource.data.student_id == request.auth.uid ||
        isTeacher() ||
        isAdmin() ||
        parentLinkedTo(resource.data.student_id)
      );
      allow write: if isAdmin();
    }

    match /quest_unit_mastery/{masteryId} {
      allow read: if signedIn() && (
        resource.data.student_id == request.auth.uid ||
        isTeacher() ||
        isAdmin() ||
        parentLinkedTo(resource.data.student_id)
      );
      allow write: if isAdmin();
    }

    match /subject_urls/{urlId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /survey_templates/{templateId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /survey_responses/{responseId} {
      allow read: if signedIn() && (
        resource.data.user_id == request.auth.uid ||
        resource.data.student_id == request.auth.uid ||
        isTeacher() ||
        isAdmin()
      );
      // 対象授業の検証とコイン付与を同一トランザクションで行う専用APIのみ作成可。
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['text', 'uid', 'name', 'role', 'created_at']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.role == role() &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 1000;
      allow update, delete: if isAdmin();
    }

    match /activity_logs/{logId} {
      allow read: if isAdmin();
      allow create: if signedIn() &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // 保護者との個別連絡は /api/parent/faq と /api/admin/parent-inquiries（Admin SDK）だけが書き込む。
    match /parent_inquiries/{inquiryId} {
      allow read: if signedIn() && (resource.data.parent_id == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // 教室への連絡の返信のひな形。マスター専用API（/api/admin/reply-templates）だけが扱う。
    match /reply_templates/{templateId} {
      allow read, write: if false;
    }

    // AIチャットの安全アラートは生徒の会話抜粋を含むため、サーバー(Admin SDK)だけが扱う。
    match /safety_alerts/{alertId} {
      allow read, write: if false;
    }

    // 管理者の操作ログ。書き込み・閲覧はサーバー（/api/admin/audit-log）だけ。ブラウザからは読めず改ざんもできない。
    match /admin_audit_logs/{logId} {
      allow read, write: if false;
    }

    // Web Push の購読情報（端末ごとの送信先）。/api/push/subscriptions（Admin SDK）だけが扱う。
    match /push_subscriptions/{subscriptionId} {
      allow read, write: if false;
    }

    match /course_enrollments/{enrollmentId} {
      allow read: if signedIn() && (
        resource.data.user_id == request.auth.uid ||
        parentLinkedTo(resource.data.user_id) ||
        isMaster()
      );
      allow create, update, delete: if isMaster();
    }

    match /eiken_courses/{courseId} {
      allow read: if signedIn();
      allow create, update, delete: if isMaster();
    }

    match /eiken_course_units/{unitId} {
      allow read, write: if isMaster();
    }

    match /eiken_tasks/{taskId} {
      allow read, write: if isMaster();
    }

    match /eiken_task_progress/{progressId} {
      allow read, write: if isMaster();
    }

    match /eiken_lessons/{lessonId} {
      allow read, write: if isMaster();
    }

    match /eiken_attendance/{attendanceId} {
      allow read, write: if isMaster();
    }

    match /eiken_assignments/{assignmentId} {
      allow read, write: if isMaster();
    }

    match /eiken_submissions/{submissionId} {
      allow read, write: if isMaster();
    }

    match /eiken_quizzes/{quizId} {
      allow read, write: if isMaster();
    }

    match /eiken_quiz_questions/{questionId} {
      allow read, write: if isMaster();
    }

    match /eiken_quiz_results/{resultId} {
      allow read, write: if isMaster();
    }

    match /eiken_writing_submissions/{submissionId} {
      allow read, write: if isMaster();
    }

    match /eiken_teacher_assignments/{assignmentId} {
      allow read, write: if isMaster();
    }

    match /eiken_announcements/{announcementId} {
      allow read, write: if isMaster();
    }

    match /eiken_follow_up_records/{recordId} {
      allow read, write: if isMaster();
    }

    // オンライン校は更新処理をAPI（Admin SDK）のトランザクションに集約する。
    // 生徒からの直接書き込みを禁止し、XPや正答情報の改ざんを防ぐ。
    match /online_school_student_progress/{progressId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /online_school_category_progress/{progressId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /online_school_learning_sessions/{sessionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /online_school_answers/{answerId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /online_school_problems/{problemId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /online_school_active_sessions/{pointerId} {
      allow read, write: if false;
    }

    function hasExplicitCollectionRules(collection) {
      return collection in [
        'users',
        'gachas',
        'gacha_draws',
        'reward_grants',
        'test_prep_course_options',
        'attendance_integration_alerts',
        'attendance_integration_batches',
        'attendance_integration_history',
        'teacher_availability_profiles',
        'learning_events',
        'recording_views',
        'coin_transactions',
        'camera_session_summaries',
        'notification_jobs',
        'notification_campaigns',
        'user_notifications',
        'password_reset_tokens',
        'email_verification_tokens',
        'password_recovery_rate_limits',
        'password_recovery_requests',
        'mail',
        'monthly_schedules',
        'annual_lesson_schedules',
        'annual_curriculum_schedules',
        'course_registration_options',
        'course_registrations',
        'attendance_correction_requests',
        'attendance',
        'submissions',
        'homework_assignments',
        'assignments',
        'class_recordings',
        'recording_playback_secrets',
        'recording_playback_sessions',
        'teacher_inquiries',
        'chat_logs',
        'community_topics',
        'community_reports',
        'teacher_community_topics',
        'contact_logs',
        'contact_call_logs',
        'zoom_host_start_logs',
        'pf_records',
        'pf_resolutions',
        'work_records',
        'attendance_payroll_rate_masters',
        'attendance_regular_imports',
        'attendance_import_batches',
        'teacher_availability',
        'teacher_commuter_passes',
        'teacher_substitution_posts',
        'requests',
        'announcements',
        'registration_requests',
        'student_registrations',
        'shift_assignments',
        'attendance_shift_plans',
        'settings',
        'system_status',
        'action_logs',
        'rewards',
        'learning_units',
        'lesson_slides',
        'quizzes',
        'quest_results',
        'quest_sessions',
        'quest_question_attempts',
        'quest_question_mastery',
        'quest_unit_mastery',
        'subject_urls',
        'survey_templates',
        'survey_responses',
        'messages',
        'activity_logs',
        'parent_inquiries',
        'safety_alerts',
        'admin_audit_logs',
        'push_subscriptions',
        'course_enrollments',
        'eiken_courses',
        'eiken_course_units',
        'eiken_tasks',
        'eiken_task_progress',
        'eiken_lessons',
        'eiken_attendance',
        'eiken_assignments',
        'eiken_submissions',
        'eiken_quizzes',
        'eiken_quiz_questions',
        'eiken_quiz_results',
        'eiken_writing_submissions',
        'eiken_teacher_assignments',
        'eiken_announcements',
        'eiken_follow_up_records',
        'online_school_student_progress',
        'online_school_category_progress',
        'online_school_learning_sessions',
        'online_school_answers',
        'online_school_problems',
        'online_school_active_sessions'
      ];
    }

    match /{collection}/{document=**} {
      allow read: if isAdmin() && !hasExplicitCollectionRules(collection);
      // 未定義コレクションへの包括的な書き込みはマスターだけに限定する。
      // 校舎管理者の操作は、上で用途ごとに定義したルールを通す。
      allow write: if isMaster() && !hasExplicitCollectionRules(collection);
    }
  }
}
