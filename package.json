{
  "name": "cutbase-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:student-read-budget && npm run lint && next build && node --import tsx --test tests/maintenance-routes.test.mts",
    "check:student-read-budget": "node scripts/check-student-read-budget.mjs",
    "start": "next start",
    "lint": "eslint",
    "security:setup": "node scripts/security/setup-local-java.mjs",
    "security:static": "node --import tsx --test tests/security/config.security.test.mts tests/security/api-boundaries.test.mjs",
    "security:rules": "node scripts/security/run-emulators.mjs exec",
    "security:deps": "npm audit --omit=dev",
    "security:start": "node scripts/security/run-emulators.mjs start",
    "security:app": "node scripts/security/run-security-app.mjs",
    "security:accounts": "node scripts/security/create-diagnosis-accounts.mjs",
    "security:staging-key": "node scripts/security/create-staging-service-account-key.mjs",
    "security:staging-accounts": "node scripts/security/seed-staging-diagnosis-accounts.mjs",
    "security:staging-data": "node scripts/security/seed-staging-diagnosis-data.mjs",
    "security:staging-verify": "node scripts/security/verify-staging-diagnosis-data.mjs",
    "security:staging-role-apis": "node scripts/security/verify-staging-role-apis.mjs",
    "security:staging-attendance-approvals": "node scripts/security/verify-staging-attendance-approvals.mjs",
    "security:staging-attendance-corrections": "node scripts/security/verify-staging-attendance-corrections.mjs",
    "security:staging-attendance-history": "node scripts/security/verify-staging-attendance-history.mjs",
    "security:staging-attendance-details": "node scripts/security/verify-staging-attendance-details.mjs",
    "security:staging-attendance-reconciliation": "node scripts/security/verify-staging-attendance-reconciliation.mjs",
    "security:staging-legacy-attendance-import": "node scripts/security/verify-staging-legacy-attendance-import.mjs",
    "security:staging-indexes": "node scripts/security/verify-staging-indexes.mjs",
    "security:staging-bulk-account-import": "node scripts/security/verify-staging-bulk-account-import.mjs",
    "security:compare-production": "node scripts/security/compare-production-diagnosis.mjs",
    "security:sync-production-rules": "node scripts/security/sync-production-rules-to-diagnosis.mjs",
    "security:staging-rules": "node scripts/security/deploy-staging-rules.mjs",
    "security:staging-vercel-env": "node scripts/security/configure-vercel-staging-env.mjs",
    "security:staging-auth-domains": "node scripts/security/configure-staging-auth-domains.mjs",
    "security:staging-allowed-ips": "node scripts/security/update-staging-allowed-ips.mjs",
    "security:test": "node scripts/security/run-security-suite.mjs",
    "qa:visual:app": "node scripts/visual-qa/run-qa-app.mjs",
    "qa:visual:seed": "node scripts/visual-qa/seed.mjs",
    "qa:visual": "node scripts/visual-qa/run.mjs",
    "eiken:seed": "node --env-file=.env.local scripts/seed-eiken-booster.mjs",
    "fam-zoom:seed": "node --env-file=.env.local scripts/seed-fam-zoom-rooms.mjs",
    "transport:generate-fares": "node scripts/generate-transport-fares-from-stations.mjs",
    "ops:backup:audit": "node --env-file=.env.local scripts/audit-backup-readiness.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.130",
    "@ai-sdk/react": "^3.0.312",
    "ai": "^6.0.309",
    "budoux": "0.9.0",
    "date-fns": "^3.6.0",
    "firebase": "^12.19.0",
    "firebase-admin": "13.10.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.427.0",
    "next": "15.5.29",
    "openai": "^4.56.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-calendar": "^5.0.0",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "server-only": "^0.0.1",
    "three": "0.186.1",
    "vue": "3.5.42",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "0.186.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.29",
    "firebase-tools": "^15.28.1",
    "postcss": "8.5.29",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.23.12",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6",
    "jsondiffpatch": "0.7.6",
    "uuid": "11.1.1",
    "undici@6": "6.28.1",
    "nanoid@3": "3.3.18",
    "postcss": "$postcss",
    "postcss-selector-parser": "7.1.7",
    "@google-cloud/pubsub": {
      "@opentelemetry/core": "2.8.0"
    }
  }
}
